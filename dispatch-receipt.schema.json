{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sanctum:federation:dispatch-receipt:1.0.0",
  "title": "Sanctum Dispatch Receipt",
  "description": "The bounded execution record for one immutable Inquiry Envelope dispatched to independently operating minister adapters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "dispatch_id",
    "created_at",
    "inquiry",
    "registry_snapshot",
    "execution_policy",
    "status",
    "minister_results",
    "integrity"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "dispatch_id": {
      "type": "string",
      "pattern": "^DSP-INQ-[0-9]{9}-[0-9a-f]{12}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "inquiry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope_id",
        "envelope_sha256"
      ],
      "properties": {
        "envelope_id": {
          "type": "string",
          "pattern": "^INQ-[0-9]{9}$"
        },
        "envelope_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "registry_snapshot": {
      "$ref": "#/$defs/registrySnapshot"
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_envelope_for_all",
        "isolated_context_required",
        "parallel_execution",
        "max_workers"
      ],
      "properties": {
        "same_envelope_for_all": {
          "const": true
        },
        "isolated_context_required": {
          "const": true
        },
        "parallel_execution": {
          "const": "PREFERRED_WHERE_AVAILABLE"
        },
        "max_workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "status": {
      "enum": [
        "COMPLETED_VALIDATED",
        "COMPLETED_WITH_MINISTER_LIMITATIONS",
        "REJECTED_REPORTS",
        "DISPATCH_FAILED"
      ]
    },
    "minister_results": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "minister_id",
          "repository_full_name",
          "repository_commit",
          "status",
          "adapter"
        ],
        "properties": {
          "minister_id": {
            "type": "string",
            "pattern": "^MIN-[0-9]{9}$"
          },
          "repository_full_name": {
            "$ref": "#/$defs/repositoryFullName"
          },
          "repository_commit": {
            "$ref": "#/$defs/gitCommit"
          },
          "status": {
            "enum": [
              "VALIDATED",
              "VALIDATED_WITH_MINISTER_LIMITATION",
              "VALIDATION_REJECTED",
              "EXECUTION_FAILED"
            ]
          },
          "adapter": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "started_at",
              "completed_at",
              "executable",
              "exit_code",
              "stdout_bytes",
              "stderr_bytes",
              "stdout_sha256",
              "stderr_sha256"
            ],
            "properties": {
              "started_at": {
                "type": "string",
                "format": "date-time"
              },
              "completed_at": {
                "type": "string",
                "format": "date-time"
              },
              "executable": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "exit_code": {
                "type": "integer"
              },
              "stdout_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "stderr_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "stdout_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "stderr_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "report_path": {
            "$ref": "#/$defs/repositoryPath"
          },
          "validation_record_path": {
            "$ref": "#/$defs/repositoryPath"
          },
          "report_file_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "secretary_outcome": {
            "enum": [
              "VALIDATED",
              "REJECTED"
            ]
          },
          "report_termination_status": {
            "enum": [
              "COMPLETED",
              "COMPLETED_WITH_LIMITATIONS",
              "INSUFFICIENT_EVIDENCE",
              "OUT_OF_JURISDICTION",
              "FAILED",
              "UNKNOWN"
            ]
          },
          "error": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "VALIDATED",
                    "VALIDATED_WITH_MINISTER_LIMITATION",
                    "VALIDATION_REJECTED"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "report_path",
                "validation_record_path",
                "report_file_sha256",
                "secretary_outcome",
                "report_termination_status"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "EXECUTION_FAILED"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "error"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "report_path"
                    ]
                  },
                  {
                    "required": [
                      "validation_record_path"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash_algorithm",
        "canonicalization",
        "receipt_sha256"
      ],
      "properties": {
        "hash_algorithm": {
          "const": "SHA-256"
        },
        "canonicalization": {
          "const": "RFC8785"
        },
        "receipt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repositoryFullName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "registrySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_full_name",
        "git_commit",
        "path",
        "sha256",
        "registry_version"
      ],
      "properties": {
        "repository_full_name": {
          "$ref": "#/$defs/repositoryFullName"
        },
        "git_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "path": {
          "const": "registry/ministers.yaml"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "registry_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    }
  }
}
