{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sanctum:federation:secretary-validation-record:1.0.0",
  "title": "Sanctum Secretary Validation Record",
  "description": "The Secretary's separate documentary record of structural, provenance, integrity, and reference checks on one submitted Ministerial Report. Validation does not certify the report or determine the truth of its findings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "validation_id",
    "validation_version",
    "record_status",
    "created_at",
    "secretary",
    "inquiry",
    "subject",
    "registry_snapshot",
    "outcome",
    "preservation_status",
    "checks",
    "constitutional_effect",
    "certification_status",
    "integrity"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "validation_id": {
      "type": "string",
      "pattern": "^SVR-[A-Z0-9-]{16,160}$"
    },
    "validation_version": {
      "const": "1.0.0"
    },
    "record_status": {
      "const": "RECORDED"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "secretary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "office",
        "actor_id"
      ],
      "properties": {
        "office": {
          "const": "SECRETARY"
        },
        "actor_id": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "inquiry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope_id",
        "envelope_sha256"
      ],
      "properties": {
        "envelope_id": {
          "type": "string",
          "pattern": "^INQ-[0-9]{9}$"
        },
        "envelope_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_id",
        "report_file_sha256",
        "minister_id",
        "repository_full_name"
      ],
      "properties": {
        "report_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "report_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "declared_report_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "minister_id": {
          "type": "string",
          "pattern": "^MIN-[0-9]{9}$"
        },
        "repository_full_name": {
          "$ref": "#/$defs/repositoryFullName"
        }
      }
    },
    "registry_snapshot": {
      "$ref": "#/$defs/registrySnapshot"
    },
    "outcome": {
      "enum": [
        "VALIDATED",
        "REJECTED"
      ]
    },
    "preservation_status": {
      "enum": [
        "ELIGIBLE_FOR_ASSEMBLY_RECORD",
        "QUARANTINED_REJECTED_REPORT"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "status",
          "required",
          "detail"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "SKIPPED"
            ]
          },
          "required": {
            "const": true
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        }
      }
    },
    "report_termination_status": {
      "enum": [
        "COMPLETED",
        "COMPLETED_WITH_LIMITATIONS",
        "INSUFFICIENT_EVIDENCE",
        "OUT_OF_JURISDICTION",
        "FAILED",
        "UNKNOWN"
      ]
    },
    "constitutional_effect": {
      "const": "PROVENANCE_VALIDATION_ONLY"
    },
    "certification_status": {
      "const": "NOT_CERTIFIED"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash_algorithm",
        "canonicalization",
        "record_sha256"
      ],
      "properties": {
        "hash_algorithm": {
          "const": "SHA-256"
        },
        "canonicalization": {
          "const": "RFC8785"
        },
        "record_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "VALIDATED"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "preservation_status": {
            "const": "ELIGIBLE_FOR_ASSEMBLY_RECORD"
          },
          "checks": {
            "not": {
              "contains": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "FAIL",
                      "SKIPPED"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "preservation_status": {
            "const": "QUARANTINED_REJECTED_REPORT"
          },
          "checks": {
            "contains": {
              "type": "object",
              "properties": {
                "status": {
                  "const": "FAIL"
                }
              },
              "required": [
                "status"
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repositoryFullName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "registrySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_full_name",
        "git_commit",
        "path",
        "sha256",
        "registry_version"
      ],
      "properties": {
        "repository_full_name": {
          "$ref": "#/$defs/repositoryFullName"
        },
        "git_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "path": {
          "const": "registry/ministers.yaml"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "registry_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    }
  }
}
