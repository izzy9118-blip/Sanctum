{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sanctum:federation:secretary-validation-record:1.1.0",
  "title": "Sanctum Secretary Validation Record",
  "type": "object",
  "required": ["record_type", "id", "inquiry_ref", "record_set", "checks", "dissent_preserved", "provenance_valid", "outcome", "presidential_synthesis", "provenance", "certification_status"],
  "properties": {
    "record_type": {"const": "secretary_validation"},
    "id": {"type": "string"},
    "inquiry_ref": {"type": "object"},
    "record_set": {"type": "array"},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["check", "status"], "properties": {"check": {"type": "string"}, "status": {"enum": ["PASS", "PENDING", "FAIL"]}, "note": {"type": "string"}}}},
    "dissent_preserved": {"type": "boolean"},
    "provenance_valid": {"type": "boolean"},
    "outcome": {"enum": ["validated", "flagged", "rejected"]},
    "presidential_synthesis": {"const": "NOT_OCCURRED"},
    "provenance": {"type": "object"},
    "certification_status": {"enum": ["PENDING_OWNER_CERTIFICATION", "OWNER_CERTIFIED"]}
  }
}
