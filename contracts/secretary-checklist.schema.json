{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sanctum:secretary-checklist:1.0.0",
  "title": "Secretary Pre-Run Checklist (SECRETARY-GATE-001)",
  "description": "The recorded artifact of the Secretary's pre-run gate. It records that the procedure was performed and in what order. It certifies nothing about truth, completeness, or the merit of any claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "gate_standard",
    "checklist_id",
    "inquiry_id",
    "board",
    "board_type",
    "minister_id",
    "room",
    "board_manifest",
    "roster",
    "query_plan",
    "query_plan_rule",
    "sequence",
    "one_shot_dispatch",
    "enumeration_precedes_gathering",
    "timestamps",
    "certification"
  ],
  "properties": {
    "record_type": {"const": "secretary_pre_run_checklist"},
    "gate_standard": {"const": "SECRETARY-GATE-001"},
    "checklist_id": {"type": "string", "pattern": "^SPC-[A-Za-z0-9_.:-]+$"},
    "inquiry_id": {"type": "string", "minLength": 1},
    "board": {"type": "string", "minLength": 1},
    "board_type": {"type": "string", "minLength": 1},
    "minister_id": {"type": "string", "minLength": 1},
    "room": {
      "description": "Where the run is executed. The gate has the same force in every room.",
      "enum": ["harness", "agent", "chat"]
    },
    "board_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "frozen", "frozen_at"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "frozen": {"const": true},
        "frozen_at": {"type": "string", "minLength": 1},
        "created_for_this_run": {"type": "boolean", "default": false}
      }
    },
    "roster": {
      "description": "The board's principals, written before the first gathering query.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["principal_id", "name", "type", "roster_state", "language", "language_state", "provenance_flag"],
        "properties": {
          "principal_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "type": {
            "description": "Person, body, or a population kind. Population kinds are principals on a polity board, never context.",
            "type": "string",
            "minLength": 1
          },
          "roster_state": {"enum": ["ENUMERATED", "ABSENT_DECLARED"]},
          "absence_reason": {"type": "string", "minLength": 1},
          "language": {
            "description": "The language in which this principal is to be heard, named per principal. The Secretary requires the naming; it never grades the answer.",
            "type": "string",
            "minLength": 1
          },
          "language_state": {"enum": ["ORIGINAL", "TRANSLATION", "UNRECORDED", "NOT_APPLICABLE"]},
          "provenance_flag": {"enum": ["HEARD_IN_OWN_WORDS", "FILLED_FROM_ELSEWHERE", "NOT_GATHERED"]},
          "file": {"type": "string", "minLength": 1}
        }
      }
    },
    "query_plan": {
      "description": "The plan of gathering, made to the whole roster and not to a thesis.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["plan_id", "principals", "information_sought", "language"],
        "properties": {
          "plan_id": {"type": "string", "minLength": 1},
          "principals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "information_sought": {"type": "string", "minLength": 1},
          "language": {"type": "string", "minLength": 1}
        }
      }
    },
    "query_plan_rule": {"const": "GATHER_TO_THE_WHOLE_ROSTER_NOT_TO_A_THESIS"},
    "sequence": {
      "description": "The declared stage sequence. The first four stages are constitutional and ordered; genealogy_finalization may follow them.",
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "investigative_query",
          "provisional_judgment",
          "adversarial_pass",
          "final_judgment",
          "genealogy_finalization"
        ]
      }
    },
    "one_shot_dispatch": {"const": "NON_CONFORMING"},
    "enumeration_precedes_gathering": {"const": true},
    "declared_absences_note": {"type": "string", "minLength": 1},
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enumerated_at", "query_plan_recorded_at", "board_frozen_at", "submitted_at"],
      "properties": {
        "enumerated_at": {"type": "string", "minLength": 1},
        "query_plan_recorded_at": {"type": "string", "minLength": 1},
        "board_frozen_at": {"type": "string", "minLength": 1},
        "submitted_at": {"type": "string", "minLength": 1},
        "first_gathering_query_at": {
          "description": "Absent or null at gate time: at the gate, nothing has been gathered yet.",
          "type": ["string", "null"]
        }
      }
    },
    "certification": {"const": "NONE_SELF_CERTIFICATION_PROHIBITED"}
  }
}
