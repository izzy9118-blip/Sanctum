{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sanctum:minister-horus-query:1.0.0",
  "title": "Mandatory Minister to Horus Query",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "query_id", "inquiry_id", "minister_id", "information_needed", "source_requirements", "reason_for_request", "provenance"],
  "properties": {
    "record_type": {"const": "minister_horus_query"},
    "query_id": {"type": "string", "pattern": "^MHQ-[A-Z0-9_-]+$"},
    "inquiry_id": {"type": "string", "minLength": 1},
    "minister_id": {"type": "string", "minLength": 1},
    "information_needed": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source_requirements": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["requirement", "rationale"], "properties": {"requirement": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1}, "acceptable_tiers": {"type": "array", "items": {"enum": ["T1", "T2", "T3", "T4", "T5"]}, "uniqueItems": true}, "original_language_required": {"type": "boolean"}}}},
    "specific_document_requests": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["document", "why_material"], "properties": {"document": {"type": "string", "minLength": 1}, "why_material": {"type": "string", "minLength": 1}}}, "default": []},
    "principal_scope": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "default": []},
    "time_scope": {"type": "object", "additionalProperties": false, "properties": {"start": {"type": ["string", "null"], "format": "date"}, "end": {"type": ["string", "null"], "format": "date"}}},
    "disallowed_substitutions": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
    "reason_for_request": {"type": "string", "minLength": 1},
    "source_selection_rule": {"const": "HORUS_RETAINS_SOURCE_SELECTION_INDEPENDENCE_EXCEPT_EXPLICIT_DOCUMENT_REQUESTS", "default": "HORUS_RETAINS_SOURCE_SELECTION_INDEPENDENCE_EXCEPT_EXPLICIT_DOCUMENT_REQUESTS"},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["produced_by", "repository_commit"], "properties": {"produced_by": {"type": "string", "minLength": 1}, "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}}
  }
}
