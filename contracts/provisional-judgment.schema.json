{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sanctum:provisional-judgment:1.0.0",
  "title": "Minister Provisional Judgment Before Adversarial Horus Call",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "inquiry_id", "minister_id", "propositions", "provenance"],
  "properties": {
    "record_type": {"const": "minister_provisional_judgment"},
    "inquiry_id": {"type": "string", "minLength": 1},
    "minister_id": {"type": "string", "minLength": 1},
    "propositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["proposition_id", "claim", "kind", "disconfirmation_need", "why_it_matters"],
        "properties": {
          "proposition_id": {"type": "string", "pattern": "^P-[A-Z0-9_-]+$"},
          "claim": {"type": "string", "minLength": 1},
          "kind": {"enum": ["documented_finding", "supported_inference", "working_hypothesis"]},
          "disconfirmation_need": {"type": "string", "minLength": 1},
          "why_it_matters": {"type": "string", "minLength": 1},
          "acceptable_tiers": {
            "type": "array",
            "items": {"enum": ["T1", "T2", "T3", "T4", "T5"]},
            "uniqueItems": true
          },
          "original_language_required": {"type": "boolean"}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["produced_by", "repository_commit"],
      "properties": {
        "produced_by": {"type": "string", "minLength": 1},
        "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    }
  }
}
