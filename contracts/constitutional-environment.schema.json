{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sanctum:constitutional-environment:1.0.0",
  "title": "Sanctum Constitutional Environment Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "standard", "inquiry_id", "sanctum", "horus", "ministers", "runtime", "certification"],
  "properties": {
    "record_type": {"const": "constitutional_environment_manifest"},
    "standard": {"const": "CONSTITUTIONAL-ENVIRONMENT-001"},
    "inquiry_id": {"type": "string", "minLength": 1},
    "certification": {"const": "NONE_SELF_CERTIFICATION_PROHIBITED"},
    "sanctum": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "repository_commit", "assembly_spec", "registry", "final_judgment_contract", "proposition_matrix_standard", "ministerial_silence_standard", "source_absence_standard"],
      "properties": {
        "repository": {"const": "izzy9118-blip/Sanctum"},
        "repository_commit": {"$ref": "#/$defs/commit"},
        "assembly_spec": {"$ref": "#/$defs/file_binding"},
        "registry": {"$ref": "#/$defs/registry_binding"},
        "final_judgment_contract": {"$ref": "#/$defs/file_binding"},
        "proposition_matrix_standard": {"$ref": "#/$defs/file_binding"},
        "ministerial_silence_standard": {"$ref": "#/$defs/file_binding"},
        "source_absence_standard": {"$ref": "#/$defs/file_binding"}
      }
    },
    "horus": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "repository_commit", "response_contract"],
      "properties": {
        "repository": {"const": "izzy9118-blip/Horus"},
        "repository_commit": {"$ref": "#/$defs/commit"},
        "response_contract": {"$ref": "#/$defs/file_binding"}
      }
    },
    "ministers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["minister_id", "repository", "pinned_commit", "manifest_path", "manifest_sha256"],
        "properties": {
          "minister_id": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
          "pinned_commit": {"$ref": "#/$defs/commit"},
          "manifest_path": {"type": "string", "minLength": 1},
          "manifest_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["python_version", "platform", "manifest_builder_path", "manifest_builder_sha256"],
      "properties": {
        "python_version": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "manifest_builder_path": {"const": "constitutional_environment.py"},
        "manifest_builder_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "registry_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "version"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "version": {"type": "string", "minLength": 1}
      }
    }
  }
}
