{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sanctum:proposition-matrix:1.0.0",
  "title": "Presidential Proposition Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "inquiry_id",
    "alignment_authority",
    "participating_ministers",
    "package_bindings",
    "rows",
    "certification"
  ],
  "properties": {
    "record_type": {"const": "presidential_proposition_matrix"},
    "inquiry_id": {"type": "string", "minLength": 1},
    "alignment_authority": {"const": "PRESIDENTIAL_ALIGNMENT"},
    "participating_ministers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "package_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["minister_id", "package_sha256"],
        "properties": {
          "minister_id": {"type": "string", "minLength": 1},
          "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["matrix_row_id", "comparison_question", "minister_entries"],
        "properties": {
          "matrix_row_id": {"type": "string", "pattern": "^ROW-[A-Z0-9_-]+$"},
          "comparison_question": {"type": "string", "minLength": 1},
          "presidential_note": {"type": ["string", "null"]},
          "minister_entries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["minister_id", "state", "propositions"],
              "properties": {
                "minister_id": {"type": "string", "minLength": 1},
                "state": {
                  "enum": [
                    "AFFIRMS",
                    "QUALIFIES",
                    "DISPUTES",
                    "UNCERTAIN",
                    "OUTSIDE_GROUND",
                    "NOT_ADDRESSED",
                    "NOT_ASKED"
                  ]
                },
                "propositions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["proposition_id", "kind", "claim"],
                    "properties": {
                      "proposition_id": {"type": "string", "pattern": "^PROP-[A-Z0-9_-]+$"},
                      "kind": {
                        "enum": [
                          "documented_finding",
                          "supported_inference",
                          "working_hypothesis",
                          "comparative_question",
                          "unresolved_uncertainty"
                        ]
                      },
                      "claim": {"type": "string", "minLength": 1}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "certification": {"const": "NONE_SELF_CERTIFICATION_PROHIBITED"}
  }
}
