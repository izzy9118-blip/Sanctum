{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sanctum:federation:ministerial-report:1.5.0",
  "title": "Sanctum Ministerial Report",
  "description": "Forward contract for reasoned reports that preserves a provisional judgment and binds exactly one investigative and one adversarial Horus exchange before finalization.",
  "type": "object",
  "required": ["record_type", "id", "report_id", "report_status", "inquiry_ref", "minister", "repository", "governing_manifest", "evidence", "propositions", "uncertainties", "termination", "provenance", "certification_status"],
  "properties": {
    "record_type": {"const": "ministerial_report"},
    "id": {"type": "string"},
    "report_id": {"type": "string"},
    "report_status": {"enum": ["DRAFT_PENDING_MINISTER_REPOSITORY_VALIDATION", "MINISTER_REPOSITORY_VALIDATED_PENDING_OWNER_CERTIFICATION", "OWNER_CERTIFIED_MINISTERIAL_REPORT"]},
    "inquiry_ref": {"type": "object"},
    "minister": {"type": "object", "required": ["actor", "manifest_commit"], "properties": {"actor": {"type": "string"}, "manifest_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "mode": {"enum": ["reasoned", "outside_my_ground"]},
    "repository": {"type": "object", "required": ["full_name", "git_commit"], "properties": {"full_name": {"type": "string"}, "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "governing_manifest": {"type": "object", "required": ["path", "version"], "properties": {"path": {"type": "string"}, "version": {"type": "string"}}},
    "provisional_judgment": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "proposition_count"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "proposition_count": {"type": "integer", "minimum": 1}}},
    "horus_exchanges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["exchange_kind", "query_id", "request_path", "response_path", "exchange_sha256", "response_status", "unfilled_request_count"],
        "properties": {
          "exchange_kind": {"enum": ["investigative", "adversarial"]},
          "query_id": {"type": "string", "pattern": "^(MHQ|MHAQ)-[A-Z0-9_-]+$"},
          "request_path": {"type": "string", "minLength": 1},
          "response_path": {"type": "string", "minLength": 1},
          "exchange_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "response_status": {"enum": ["GATHERED", "PARTIALLY_GATHERED", "NOT_GATHERED"]},
          "unfilled_request_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["witness_id", "source_id", "repository_commit", "path"], "properties": {"witness_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*-WIT-[A-Z0-9]+(?:-[A-Z0-9]+)*$"}, "source_id": {"type": "string", "minLength": 1}, "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "path": {"type": "string", "minLength": 1}}}},
    "propositions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["kind", "claim"], "properties": {"kind": {"enum": ["documented_finding", "supported_inference", "working_hypothesis", "comparative_question", "unresolved_uncertainty"]}, "claim": {"type": "string"}, "grounds": {"type": "array"}}}},
    "uncertainties": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "termination": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string"}}},
    "provenance": {"type": "object"},
    "certification_status": {"enum": ["PENDING_OWNER_CERTIFICATION", "OWNER_CERTIFIED"]}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "reasoned"}}, "required": ["mode"]},
      "then": {
        "required": ["provisional_judgment", "horus_exchanges"],
        "properties": {"horus_exchanges": {"minItems": 2, "maxItems": 2}},
        "allOf": [
          {"properties": {"horus_exchanges": {"contains": {"type": "object", "properties": {"exchange_kind": {"const": "investigative"}, "query_id": {"pattern": "^MHQ-"}}, "required": ["exchange_kind", "query_id"]}, "minContains": 1, "maxContains": 1}}},
          {"properties": {"horus_exchanges": {"contains": {"type": "object", "properties": {"exchange_kind": {"const": "adversarial"}, "query_id": {"pattern": "^MHAQ-"}}, "required": ["exchange_kind", "query_id"]}, "minContains": 1, "maxContains": 1}}}
        ]
      }
    }
  ]
}
