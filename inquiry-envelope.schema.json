{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sanctum:federation:inquiry-envelope:1.0.0",
  "title": "Sanctum Inquiry Envelope",
  "description": "Immutable inquiry envelope. Universal participation is constitutional; every established minister receives this same envelope.",
  "type": "object",
  "required": ["record_type", "id", "envelope_id", "status", "question", "raw_situation", "routing", "integrity", "provenance", "certification_status"],
  "properties": {
    "record_type": {"const": "inquiry_envelope"},
    "id": {"type": "string"},
    "envelope_id": {"type": "string"},
    "status": {"const": "ISSUED"},
    "question": {"type": "string", "minLength": 1},
    "raw_situation": {"type": "string", "minLength": 1},
    "routing": {
      "type": "object",
      "required": ["policy", "dispatched_ministers"],
      "properties": {
        "policy": {"const": "UNIVERSAL"},
        "dispatched_ministers": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "integrity": {"type": "object", "required": ["hash_algorithm", "envelope_sha256"], "properties": {"hash_algorithm": {"const": "SHA-256"}, "envelope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "provenance": {"type": "object"},
    "certification_status": {"const": "PENDING_OWNER_CERTIFICATION"}
  }
}
