{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanctum.local/schemas/project-state.schema.json",
  "title": "Sanctum Reconstructable Project State",
  "type": "object",
  "additionalProperties": false,
  "required": ["state_version", "repository", "mission", "authority_order", "active_work"],
  "properties": {
    "state_version": {"const": "1.0.0"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "commit"],
      "properties": {
        "name": {"type": "string"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "branch": {"type": "string"}
      }
    },
    "mission": {"type": "string", "minLength": 1},
    "authority_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "active_work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "next_action"],
      "properties": {
        "inquiry_id": {"type": ["string", "null"]},
        "status": {"type": "string"},
        "next_action": {"type": "string"},
        "open_uncertainties": {"type": "array", "items": {"type": "string"}}
      }
    },
    "required_reading": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "prohibited_assumptions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
