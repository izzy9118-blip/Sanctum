{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sanctum:federation:minister-manifest:1.0.0",
  "title": "Sanctum Minister Manifest",
  "description": "A registry entry that identifies one minister, pins its independent repository and governing manifest, states its jurisdiction, and declares whether it is technically routable.",
  "$comment": "Schema validation establishes structure only. The registry loader must verify commit reachability, recompute all content hashes, match Git blob identifiers, and reject every entry whose routing_status is not explicitly selectable under the registry policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "manifest_id",
    "manifest_version",
    "minister",
    "jurisdiction",
    "repository",
    "governing_manifest",
    "authority_records",
    "registration",
    "federation"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "manifest_id": {
      "$ref": "#/$defs/manifestId"
    },
    "manifest_version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "minister": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minister_id",
        "name",
        "office"
      ],
      "properties": {
        "minister_id": {
          "$ref": "#/$defs/ministerId"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "office": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_domain",
        "statement",
        "selection_guidance"
      ],
      "properties": {
        "primary_domain": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "selection_guidance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "exclusions": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_name",
        "canonical_url",
        "default_branch",
        "pinned_commit",
        "canonical_authority"
      ],
      "properties": {
        "full_name": {
          "$ref": "#/$defs/repositoryFullName"
        },
        "canonical_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/"
        },
        "default_branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "pinned_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "canonical_authority": {
          "const": "GIT"
        }
      }
    },
    "governing_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "path",
        "media_type",
        "sha256",
        "git_blob_sha",
        "release_status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/repositoryIdentifier"
        },
        "version": {
          "$ref": "#/$defs/versionLabel"
        },
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "media_type": {
          "enum": [
            "application/json",
            "application/yaml",
            "text/yaml",
            "text/plain"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "git_blob_sha": {
          "$ref": "#/$defs/gitObjectId"
        },
        "declared_repository_commit": {
          "$ref": "#/$defs/gitCommit",
          "description": "The repository commit asserted inside the governing manifest, when the manifest makes such an assertion. It may differ from the pinned commit containing the manifest."
        },
        "release_status": {
          "enum": [
            "RELEASED",
            "CERTIFIED",
            "ADMITTED",
            "PROVISIONAL"
          ]
        }
      }
    },
    "authority_records": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "path",
          "sha256",
          "git_blob_sha",
          "relationship"
        ],
        "properties": {
          "record_id": {
            "$ref": "#/$defs/repositoryIdentifier"
          },
          "version": {
            "$ref": "#/$defs/versionLabel"
          },
          "path": {
            "$ref": "#/$defs/repositoryPath"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "git_blob_sha": {
            "$ref": "#/$defs/gitObjectId"
          },
          "relationship": {
            "enum": [
              "ACTIVE_GOVERNANCE_SPECIFICATION",
              "CERTIFICATION_RECORD",
              "ADMISSION_RECORD",
              "CORRECTION_RECORD",
              "OTHER_GOVERNING_AUTHORITY"
            ]
          }
        }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "membership_status",
        "registered_at",
        "authority"
      ],
      "properties": {
        "membership_status": {
          "enum": [
            "ESTABLISHED",
            "CANDIDATE",
            "SUSPENDED",
            "RETIRED"
          ]
        },
        "registered_at": {
          "type": "string",
          "format": "date-time"
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository_full_name",
            "git_commit",
            "path",
            "git_blob_sha"
          ],
          "properties": {
            "repository_full_name": {
              "$ref": "#/$defs/repositoryFullName"
            },
            "git_commit": {
              "$ref": "#/$defs/gitCommit"
            },
            "path": {
              "$ref": "#/$defs/repositoryPath"
            },
            "git_blob_sha": {
              "$ref": "#/$defs/gitObjectId"
            }
          }
        }
      }
    },
    "federation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routing_status",
        "accepts_schema",
        "produces_schema",
        "adapter"
      ],
      "properties": {
        "routing_status": {
          "enum": [
            "PENDING_ADAPTER",
            "AVAILABLE",
            "DISABLED",
            "RETIRED"
          ]
        },
        "accepts_schema": {
          "const": "urn:sanctum:federation:inquiry-envelope:1.0.0"
        },
        "produces_schema": {
          "const": "urn:sanctum:federation:ministerial-report:1.0.0"
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "NOT_IMPLEMENTED",
                "IN_DEVELOPMENT",
                "AVAILABLE",
                "SUSPENDED"
              ]
            },
            "interface_version": {
              "$ref": "#/$defs/semanticVersion"
            },
            "path": {
              "$ref": "#/$defs/repositoryPath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "note": {
              "type": "string",
              "maxLength": 5000
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "AVAILABLE"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "interface_version": {
                    "$ref": "#/$defs/semanticVersion"
                  },
                  "path": {
                    "$ref": "#/$defs/repositoryPath"
                  },
                  "sha256": {
                    "$ref": "#/$defs/sha256"
                  }
                },
                "required": [
                  "interface_version",
                  "path",
                  "sha256"
                ]
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "routing_status": {
                "const": "AVAILABLE"
              }
            },
            "required": [
              "routing_status"
            ]
          },
          "then": {
            "properties": {
              "adapter": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "AVAILABLE"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "federation": {
            "type": "object",
            "properties": {
              "routing_status": {
                "const": "AVAILABLE"
              }
            },
            "required": [
              "routing_status"
            ]
          }
        },
        "required": [
          "federation"
        ]
      },
      "then": {
        "properties": {
          "registration": {
            "type": "object",
            "properties": {
              "membership_status": {
                "const": "ESTABLISHED"
              }
            },
            "required": [
              "membership_status"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "versionLabel": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(?:\\.(0|[1-9][0-9]*)){1,2}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "ministerId": {
      "type": "string",
      "pattern": "^MIN-[0-9]{9}$"
    },
    "manifestId": {
      "type": "string",
      "pattern": "^MNF-[0-9]{9}$"
    },
    "repositoryIdentifier": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{9}$"
    },
    "repositoryFullName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "gitObjectId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
